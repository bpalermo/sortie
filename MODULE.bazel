module(
    name = "sortie",
    version = "0.1.0",
)

bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "aspect_rules_lint", version = "2.9.0")

# Named by //bazel/image for string_flag.
bazel_dep(name = "bazel_skylib", version = "1.8.2")
bazel_dep(name = "rules_img", version = "0.3.21")
bazel_dep(name = "rules_helm", version = "0.32.0")

# Transitive dependency of rules_img, pinned when this repo was on Bazel 9:
# older versions reach it through rules_pkg and use the removed
# incompatible_use_toolchain_transition keyword. Also fine on 8.8.
bazel_dep(name = "rules_foreign_cc", version = "0.16.0")
bazel_dep(name = "buildifier_prebuilt", version = "10.0.1")

# Named directly by the select() in //bazel/lint that picks buildifier's
# platform-appropriate binary.
bazel_dep(name = "platforms", version = "1.1.0")

# @buildifier_prebuilt//:buildifier is a toolchain-resolved launcher script
# that locates its real, platform-specific binary via its own runfiles.
# aspect_rules_lint's buildifier aspect runs that launcher as a bare
# sandboxed action tool (ctx.actions.run_shell(tools = [...])), and in that
# path Bazel never stages the launcher's runfiles tree with the MANIFEST
# it depends on to resolve "../buildifier_prebuilt.../file/buildifier", so
# buildifier_test fails with "Unable to locate buildifier runfile: ...".
# This reproduces even with aspect_rules_lint's own upstream fix for this
# exact bug (https://github.com/aspect-build/rules_lint/pull/991) applied,
# so it is specific to how aspects (as opposed to rules) create actions.
# Sidestep the launcher entirely: reach into buildifier_prebuilt's own
# module extension for the raw downloaded binaries, which are self-contained
# executables with no runfiles of their own. bazel/lint/linters.bzl selects
# among them by platform, since bypassing the launcher also bypasses the
# toolchain resolution that would otherwise have picked one.
buildifier_prebuilt_deps = use_extension(
    "@buildifier_prebuilt//:defs.bzl",
    "buildifier_prebuilt_deps_extension",
)
use_repo(
    buildifier_prebuilt_deps,
    "buildifier_darwin_amd64",
    "buildifier_darwin_arm64",
    "buildifier_linux_amd64",
    "buildifier_linux_arm64",
)

# Envoy, for the load engine that is moving into this workspace. The commit is
# pinned with git_override rather than taken from a registry snapshot, so the
# engine can build at any Envoy commit; the registry (see --registry in
# .bazelrc) still supplies Envoy's transitive ".envoy"-suffixed modules and has
# to be the commit Envoy's own .bazelrc pins at ENVOY_COMMIT. envoy_api also
# supplies the .proto files and the go_proto_library targets whose importpaths
# match go-control-plane; generating those ourselves would put a second copy of
# every envoy message in the binary and panic at init on duplicate registration.
ENVOY_COMMIT = "3ded46ef9e7550711e966b8011191d43281ab68f"

bazel_dep(name = "envoy", version = "1.40.0-dev")
bazel_dep(name = "envoy_api", version = "1.40.0-dev")

git_override(
    module_name = "envoy",
    commit = ENVOY_COMMIT,
    remote = "https://github.com/envoyproxy/envoy.git",
)

git_override(
    module_name = "envoy_api",
    commit = ENVOY_COMMIT,
    remote = "https://github.com/envoyproxy/envoy.git",
    strip_prefix = "api",
)

# Constraints on the plan schema are declared in the proto itself.
bazel_dep(name = "protovalidate", version = "1.2.2")

# protobuf owns proto_library now; rules_proto only re-exports it and is
# deprecated, so the rule is loaded from the protobuf module directly. The
# version is Envoy's, from its registry.
bazel_dep(name = "protobuf", version = "35.1.bcr.envoy")

# Versions follow envoy_api's own, so the proto graph resolves to one copy of
# each dependency rather than two.
bazel_dep(name = "googleapis", version = "0.0.0-20251003-2193a2bf")
bazel_dep(name = "googleapis-go", version = "1.0.0")
bazel_dep(name = "protoc-gen-validate", version = "1.3.3.envoy")

# The Go SDK and the Bazel version in .bazelversion track Envoy's pins (go_sdk
# 1.27.1 and Bazel 8.8.0 at envoyproxy/envoy 3ded46e, 2026-10-01), so that the
# Envoy-based load engine can share this workspace. Bump them together with the
# Envoy pin, not independently.
go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.27.1")

# nogo's analyzers (TOOLS_NOGO) are @org_golang_x_tools//go/analysis/...,
# and go_deps below resolves one x/tools across every bzlmod module by MVS.
# rules_go 0.63.0's own go.mod pins x/tools v0.34.0, whose export data
# reader tops out at version 2 and cannot read Go 1.27's version 4 ("export
# data version 4 is greater than maximum supported version 2"). go.mod
# carries golang.org/x/tools >= v0.48.0 (bazel-contrib/rules_go#4701, which
# postdates rules_go 0.63.0 and only bumped rules_go's own go.mod) purely to
# raise that MVS floor so nogo can run on this Go 1.27 SDK.
go_sdk.nogo(nogo = "//:nogo")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# genproto's rpc/status is needed by the engine's Go proto targets (engine/api):
# the engine's protos import google/rpc/status.proto, and its Go code has to be the same
# package grpc-go already links or the binary fails to link with a
# "multiple copies of package" conflict.
#
# `bazel mod tidy` rewrites this list from go.mod's DIRECT requirements and
# knows nothing about BUILD files, so genproto is a direct requirement there
# even though no Go source here imports it. Demote it to // indirect and the
# next tidy silently drops this entry and the build breaks.
use_repo(
    go_deps,
    "build_buf_gen_go_bufbuild_protovalidate_protocolbuffers_go",
    "build_buf_go_protovalidate",
    "build_buf_go_protoyaml",
    "com_github_envoyproxy_go_control_plane_envoy",
    "com_github_spf13_cobra",
    "in_gopkg_yaml_v3",
    "org_golang_google_genproto_googleapis_rpc",
    "org_golang_google_grpc",
    "org_golang_google_protobuf",
    "org_golang_x_sync",
)

# cel.dev/cel-go, pulled in by buf.build/go/protovalidate, ships checked-in
# BUILD.bazel files using the legacy go_default_library naming, which gazelle's
# default "auto" mode honours -- so the targets rules_go expects do not exist.
go_deps.gazelle_override(
    build_file_generation = "on",
    directives = ["gazelle:proto disable"],
    path = "cel.dev/cel-go",
)
go_deps.gazelle_override(
    build_file_generation = "off",
    path = "cel.dev/expr",
)

####################################################################################
# Load engine (engine/): the Envoy-based Nighthawk fork
####################################################################################

# Modules the engine's BUILD files name directly, at the versions Envoy pins.
bazel_dep(name = "rules_python", version = "2.3.3")
bazel_dep(name = "proxy-wasm-cpp-host", version = "0.0.0-260704-f2db56a.envoy")
bazel_dep(name = "googleurl", version = "0.0.0-221103-dd4080f.envoy")
bazel_dep(name = "rules_rust", version = "0.74.0.envoy")
bazel_dep(name = "grpc", version = "1.83.0.envoy")
bazel_dep(name = "librdkafka", version = "2.15.0")
bazel_dep(name = "quiche", version = "0.0.0-260922-7f07dc4.envoy")
bazel_dep(name = "toolchains_llvm", version = "1.9.1.envoy")
bazel_dep(name = "envoy_toolshed", version = "0.5.2.envoy")
bazel_dep(name = "zlib-ng", version = "2.3.3.bcr.2")
bazel_dep(name = "googletest", version = "1.18.0.bcr.1")
bazel_dep(name = "re2", version = "2025-11-05.bcr.1")
bazel_dep(name = "libsxg", version = "0.0.0-210708-beaa393.envoy")
bazel_dep(name = "abseil-cpp", version = "20260817.0", repo_name = "com_google_absl")

http_archive = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_archive")

http_archive(
    name = "dep_hdrhistogram_c",
    build_file_content = """
cc_library(
    name = "hdrhistogram_c",
    srcs = [
        "src/hdr_encoding.c",
        "src/hdr_histogram.c",
        "src/hdr_histogram_log.c",
        "src/hdr_interval_recorder.c",
        "src/hdr_malloc.h",
        "src/hdr_thread.c",
        "src/hdr_time.c",
        "src/hdr_writer_reader_phaser.c",
    ],
    hdrs = [
        "src/hdr_atomic.h",
        "src/hdr_encoding.h",
        "src/hdr_endian.h",
        "include/hdr/hdr_histogram.h",
        "include/hdr/hdr_histogram_log.h",
        "include/hdr/hdr_interval_recorder.h",
        "include/hdr/hdr_writer_reader_phaser.h",
        "src/hdr_tests.h",
        "include/hdr/hdr_thread.h",
        "include/hdr/hdr_time.h",
    ],
    includes = ["include"],
    copts = [
        "-std=gnu99",
        "-Wno-implicit-function-declaration",
        "-Wno-error",
    ],
    deps = ["@zlib-ng"],
    visibility = ["//visibility:public"],
)
""",
    sha256 = "bb95351a6a8b242dc9be1f28562761a84d4cf0a874ffc90a9b630770a6468e94",
    strip_prefix = "HdrHistogram_c-0.11.8",
    url = "https://github.com/HdrHistogram/HdrHistogram_c/archive/0.11.8.tar.gz",
)

# rules_python only honours is_default from the root module, so the default
# Python toolchain Envoy's tooling and the engine's integration tests need is
# declared here.
python = use_extension("@rules_python//python/extensions:python.bzl", "python")
python.toolchain(
    is_default = True,
    python_version = "3.12",
)
use_repo(python, "python_3_12", python = "python_versions")

pip = use_extension("@rules_python//python/extensions:pip.bzl", "pip")
pip.parse(
    hub_name = "nh_pip3",
    python_version = "3.12",
    requirements_lock = "//engine/tools/base:requirements.txt",
)
use_repo(pip, "nh_pip3")

llvm = use_extension("@toolchains_llvm//toolchain/extensions:llvm.bzl", "llvm")
use_repo(llvm, "llvm_toolchain")

llvm_toolchain_alias_ext = use_extension("@envoy_toolshed//compile:extensions.bzl", "llvm_toolchain_alias_extension")
use_repo(llvm_toolchain_alias_ext, "llvm_toolchain_llvm")

# @clang_platform: the RBE host platform Envoy's remote-exec config names, and
# the parent of the BuildBuddy platforms in //bazel/platforms.
envoy_toolchains_ext = use_extension("@envoy//bazel:extensions.bzl", "envoy_toolchains_extension")
use_repo(envoy_toolchains_ext, "clang_platform")

# Helm's own binary, so the chart is built and linted with a pinned toolchain
# rather than whatever is on a developer's PATH.
helm = use_extension("@rules_helm//helm:extensions.bzl", "helm")
helm.host_tools()
use_repo(helm, "helm", "helm_toolchains")

register_toolchains("@helm_toolchains//:all")

# The image base. Pinned by digest: a tag would let the contents of a release
# change without the build changing.
pull = use_repo_rule("@rules_img//img:pull.bzl", "pull")

pull(
    name = "distroless_static",
    digest = "sha256:1c2c046bc09ed40fad370b599a0b1ae7987f55b01e247cf27a7c27cd97e5bbc7",
    layer_handling = "lazy",
    registry = "gcr.io",
    repository = "distroless/static-debian13",
)
