module(
    name = "sortie",
    version = "0.1.0",
)

bazel_dep(name = "rules_go", version = "0.63.0")
bazel_dep(name = "gazelle", version = "0.54.0")
bazel_dep(name = "aspect_rules_lint", version = "2.9.0")
bazel_dep(name = "buildifier_prebuilt", version = "10.0.1")

# Named directly by the select() in //bazel/lint that picks buildifier's
# platform-appropriate binary.
bazel_dep(name = "platforms", version = "1.1.0")

# @buildifier_prebuilt//:buildifier is a toolchain-resolved launcher script
# that locates its real, platform-specific binary via its own runfiles.
# aspect_rules_lint's buildifier aspect runs that launcher as a bare
# sandboxed action tool (ctx.actions.run_shell(tools = [...])), and in that
# path Bazel never stages the launcher's runfiles tree with the MANIFEST
# it depends on to resolve "../buildifier_prebuilt.../file/buildifier", so
# buildifier_test fails with "Unable to locate buildifier runfile: ...".
# This reproduces even with aspect_rules_lint's own upstream fix for this
# exact bug (https://github.com/aspect-build/rules_lint/pull/991) applied,
# so it is specific to how aspects (as opposed to rules) create actions.
# Sidestep the launcher entirely: reach into buildifier_prebuilt's own
# module extension for the raw downloaded binaries, which are self-contained
# executables with no runfiles of their own. bazel/lint/linters.bzl selects
# among them by platform, since bypassing the launcher also bypasses the
# toolchain resolution that would otherwise have picked one.
buildifier_prebuilt_deps = use_extension(
    "@buildifier_prebuilt//:defs.bzl",
    "buildifier_prebuilt_deps_extension",
)
use_repo(
    buildifier_prebuilt_deps,
    "buildifier_darwin_amd64",
    "buildifier_darwin_arm64",
    "buildifier_linux_amd64",
    "buildifier_linux_arm64",
)

# Nighthawk's protos import envoy's, so envoy_api supplies both the .proto files
# and the go_proto_library targets whose importpaths match go-control-plane.
# Generating those ourselves instead would put a second copy of every envoy
# message in the binary and panic at init on duplicate registration.
bazel_dep(name = "envoy_api", version = "0.0.0-20260901-005c18a.bcr.1")

# Constraints on the plan schema are declared in the proto itself.
bazel_dep(name = "protovalidate", version = "1.2.2")

# protobuf owns proto_library now; rules_proto only re-exports it and is
# deprecated, so the rule is loaded from the protobuf module directly.
bazel_dep(name = "protobuf", version = "33.4", repo_name = "com_google_protobuf")

# Versions follow envoy_api's own, so the proto graph resolves to one copy of
# each dependency rather than two.
bazel_dep(name = "googleapis", version = "0.0.0-20251003-2193a2bf")
bazel_dep(name = "googleapis-go", version = "1.0.0")
bazel_dep(
    name = "protoc-gen-validate",
    version = "1.2.1.bcr.2",
    repo_name = "com_envoyproxy_protoc_gen_validate",
)

go_sdk = use_extension("@rules_go//go:extensions.bzl", "go_sdk")
go_sdk.download(version = "1.27.1")

# nogo's analyzers (TOOLS_NOGO) are @org_golang_x_tools//go/analysis/...,
# and go_deps below resolves one x/tools across every bzlmod module by MVS.
# rules_go 0.63.0's own go.mod pins x/tools v0.34.0, whose export data
# reader tops out at version 2 and cannot read Go 1.27's version 4 ("export
# data version 4 is greater than maximum supported version 2"). go.mod
# carries golang.org/x/tools >= v0.48.0 (bazel-contrib/rules_go#4701, which
# postdates rules_go 0.63.0 and only bumped rules_go's own go.mod) purely to
# raise that MVS floor so nogo can run on this Go 1.27 SDK.
go_sdk.nogo(nogo = "//tools/nogo:nogo")

go_deps = use_extension("@gazelle//:extensions.bzl", "go_deps")
go_deps.from_file(go_mod = "//:go.mod")

# genproto's rpc/status is needed by bazel/nighthawk/nighthawk_api.BUILD: the Nighthawk
# protos import google/rpc/status.proto, and its Go code has to be the same
# package grpc-go already links or the binary fails to link with a
# "multiple copies of package" conflict.
#
# `bazel mod tidy` rewrites this list from go.mod's DIRECT requirements and
# knows nothing about BUILD files, so genproto is a direct requirement there
# even though no Go source here imports it. Demote it to // indirect and the
# next tidy silently drops this entry and the build breaks.
use_repo(
    go_deps,
    "build_buf_gen_go_bufbuild_protovalidate_protocolbuffers_go",
    "build_buf_go_protovalidate",
    "build_buf_go_protoyaml",
    "com_github_envoyproxy_go_control_plane_envoy",
    "com_github_spf13_cobra",
    "in_gopkg_yaml_v3",
    "org_golang_google_genproto_googleapis_rpc",
    "org_golang_google_grpc",
    "org_golang_google_protobuf",
    "org_golang_x_sync",
)

# Nighthawk's protos, pinned. They are fetched rather than vendored so there is
# no second copy to drift, and generated by Bazel rather than checked in so the
# Go bindings cannot go stale against the .proto files they came from.
nighthawk_api = use_extension("//bazel/nighthawk:nighthawk.bzl", "nighthawk_api")
use_repo(nighthawk_api, "nighthawk_api")

# cel.dev/cel-go, pulled in by buf.build/go/protovalidate, ships checked-in
# BUILD.bazel files using the legacy go_default_library naming, which gazelle's
# default "auto" mode honours -- so the targets rules_go expects do not exist.
go_deps.gazelle_override(
    build_file_generation = "on",
    directives = ["gazelle:proto disable"],
    path = "cel.dev/cel-go",
)
go_deps.gazelle_override(
    build_file_generation = "off",
    path = "cel.dev/expr",
)
