# Module registries. Envoy's transitive dependencies with an ".envoy" version
# suffix exist only in Envoy's own registry, which keeps a single rolling
# snapshot per module and deletes older ones, so the commit here is part of the
# Envoy pin: it must be the one Envoy's .bazelrc names at the ENVOY_COMMIT in
# MODULE.bazel. Bump the two together.
common --registry=https://bcr.bazel.build/
common --registry=https://raw.githubusercontent.com/envoyproxy/bazel-registry/462e7c8781a6a94be81f7f3383a1c88b5347c58f

build --enable_platform_specific_config
build --incompatible_strict_action_env

# Image labels and tags carry the git commit; this is where it comes from. The
# script never fails, so it cannot break a build.
build --workspace_status_command=bazel/workspace_status.sh

# Stamp by default. rules_helm has no per-target equivalent of the image rules'
# stamp = "force": helm_package always defers to this flag, so without it a
# chart built outside a release carries the literal placeholders
# "0.1.0-GIT-COMMIT" and "STABLE-GIT-VERSION" as its versions. Only the image
# manifest and the chart consume the workspace status, so this re-runs two
# cheap actions per commit and nothing else.
build --stamp

test --test_output=errors
test --test_verbose_timeout_warnings

#############################################################################
# ENGINE: the subset of Envoy's build configuration the engine needs, as
# Nighthawk inherited it. The unconditional lines are Envoy's verbatim (they
# are part of every action's key; changing one rebuilds Envoy). Of Envoy's
# named configs only these are kept: asan, tsan and what they expand to,
# libc++, linux, compdb, and Nighthawk's own (marked # unique). Everything
# else -- coverage, fuzzing, msan, gcc, docker, macOS, FIPS, EngFlow -- is
# dropped; bazel/bump-envoy.sh reports what Envoy's .bazelrc has that this
# section does not, which is where a bump starts.
#############################################################################

build:asan --test_timeout=4800  # unique
build:tsan --test_timeout=4800  # unique
# See https://github.com/envoyproxy/nighthawk/issues/405

# Test configuration flags
# Enable stress tests (expensive tests that are skipped by default)
test:stress --//engine/test/config:run_stress_tests=True  # unique

# CI configuration
build:download-toplevel --remote_download_outputs=toplevel  # unique
#############################################################################
# startup
#############################################################################

# Bazel doesn't need more than 200MB of memory for local build based on memory profiling:
# https://docs.bazel.build/versions/master/skylark/performance.html#memory-profiling
# The default JVM max heapsize is 1/4 of physical memory up to 32GB which could be large
# enough to consume all memory constrained by cgroup in large host.
# Limiting JVM heapsize here to let it do GC more when approaching the limit to
# leave room for compiler/linker.
# The number 3G is chosen heuristically to both support large VM and small VM with RBE.
# Startup options cannot be selected via config.
# TODO: Adding just to test android
startup --host_jvm_args=-Xmx3g
startup --host_jvm_args="-DBAZEL_TRACK_SOURCE_DIRECTORIES=1"

common --noincompatible_disallow_empty_glob
common --noincompatible_disallow_ctx_resolve_tools
common --legacy_external_runfiles

build --jobs=HOST_CPUS-1
build --incompatible_strict_action_env
# silence absl logspam.
build --copt=-DABSL_MIN_LOG_LEVEL=4
# Global C++ standard and common warning suppressions
build --experimental_repository_downloader_retries=2
build --experimental_cc_static_library
build --enable_platform_specific_config
build --incompatible_merge_fixed_and_default_shell_env
# A workaround for slow ICU download.
build --http_timeout_scaling=6.0

# Allow stamped caches to bust when local filesystem changes.
# Requires setting `BAZEL_VOLATILE_DIRTY` in the env.
build --action_env=BAZEL_VOLATILE_DIRTY --host_action_env=BAZEL_VOLATILE_DIRTY

build --test_summary=terse

# rules_external_jvm triggers unwanted android toolchain setup if this is set
# if you actually require this you should override it (see mobile/.bazelrc)
common --repo_env=ANDROID_HOME=

# TODO(keith): Remove once these 2 are the default
build --incompatible_config_setting_private_default_visibility
build --incompatible_enforce_config_setting_visibility

test --test_verbose_timeout_warnings
test --experimental_ui_max_stdouterr_bytes=11712829 #default 1048576

# Allow tags to influence execution requirements
common --incompatible_allow_tags_propagation

# We already have absl in the build, define absl=1 to tell googletest to use absl for backtrace.
build --define absl=1

# Test options
build --test_env=HEAPCHECK=normal --test_env=PPROF_PATH


# Envoy deprecation
common --@envoy//bazel:deprecated_repo_arg_allowed=false

# BCR modules with no registry override — deprecated absl Mutex shims / TSA false positives / fuzz semantics.
build --per_file_copt=external/antlr4-cpp-runtime.*@-Wno-deprecated-declarations
build --per_file_copt=external/c-ares.*@-Wno-unused-function
build --per_file_copt=external/google_benchmark.*@-Wno-thread-safety-analysis
build --per_file_copt=external/libprotobuf-mutator.*@-Wno-unused-result
build --per_file_copt=external/re2.*@-Wno-deprecated-declarations

# Python
common --@rules_python//python/config_settings:bootstrap_impl=script
build --incompatible_default_to_explicit_init_py

# Rust
# Specifies the rustfmt.toml for all rustfmt_test targets.
build --@rules_rust//rust/settings:rustfmt.toml=@envoy//:rustfmt.toml
common --@rules_rust//rust/settings:skip_fission_for_rust=true

# kafka
build --@librdkafka//:with_ssl=false
build --@librdkafka//:with_zlib=false
build --per_file_copt=contrib/kafka/.*\.cc@-Wno-old-style-cast

common --incompatible_enable_proto_toolchain_resolution

# these are here to detect if the toolchain attempts to compile protoc
common --per_file_copt=bazel-out/.*/bin/external/protobuf.*/protoc@--THIS_CC_TOOLCHAIN_IS_BROKEN

# TODO(phlax): Remove this once a proper fix for the deprecated enum lands
build --per_file_copt=external/envoy_api.*/route_components\.pb\.cc@-Wno-deprecated-declarations

build:linux --copt=-fdebug-types-section
# Enable position independent code (this is the default on macOS and Windows)
# (Workaround for https://github.com/bazelbuild/rules_foreign_cc/issues/421)
build:linux --copt=-fPIC
build:linux --conlyopt=-fexceptions
build:linux --fission=dbg,opt
build:linux --features=per_object_debug_info

# libc++ - default for clang
common:libc++ --action_env=CXXFLAGS=-stdlib=libc++
common:libc++ --action_env=LDFLAGS="-stdlib=libc++ -fuse-ld=lld"
common:libc++ --action_env=BAZEL_CXXOPTS=-stdlib=libc++
common:libc++ --action_env=BAZEL_LINKLIBS=-l%:libc++.a:-l%:libc++abi.a
common:libc++ --action_env=BAZEL_LINKOPTS=-lm:-pthread

# Common flags for sanitizers
build:sanitizer --define tcmalloc=disabled
build:sanitizer --linkopt -ldl
test:sanitizer --build_tests_only

# ASAN config with clang runtime
build:asan --config=asan-common
build:asan --linkopt --rtlib=compiler-rt
build:asan --linkopt --unwindlib=libgcc
build:asan --linkopt=-l:libclang_rt.ubsan_standalone.a
build:asan --linkopt=-l:libclang_rt.ubsan_standalone_cxx.a
build:asan --action_env=ENVOY_UBSAN_VPTR=1
build:asan --copt=-fsanitize=vptr,function
build:asan --linkopt=-fsanitize=vptr,function
build:asan --linkopt='-L/opt/llvm/lib/clang/22/lib/x86_64-unknown-linux-gnu'

# Basic ASAN/UBSAN that works for gcc or llvm
build:asan-common --config=sanitizer
# ASAN install its signal handler, disable ours so the stacktrace will be printed by ASAN
build:asan-common --define signal_trace=disabled
build:asan-common --define ENVOY_CONFIG_ASAN=1
build:asan-common --build_tag_filters=-no_san
build:asan-common --test_tag_filters=-no_san
# The following two lines were manually edited due to nighthawk#593.
# Flag undefined was dropped from both the lines to allow CI/ASAN to pass.
build:asan-common --copt -fsanitize=address  # unique
build:asan-common --linkopt -fsanitize=address  # unique
# vptr and function sanitizer are enabled in asan
build:asan-common --copt -fno-sanitize=vptr,function
build:asan-common --linkopt -fno-sanitize=vptr,function
build:asan-common --copt -DADDRESS_SANITIZER=1
build:asan-common --copt -DUNDEFINED_SANITIZER=1
build:asan-common --copt -D__SANITIZE_ADDRESS__
build:asan-common --test_env=ASAN_OPTIONS=handle_abort=1:allow_addr2line=true:check_initialization_order=true:strict_init_order=true:detect_odr_violation=1
build:asan-common --test_env=UBSAN_OPTIONS=halt_on_error=true:print_stacktrace=1
build:asan-common --test_env=ASAN_SYMBOLIZER_PATH
# ASAN needs -O1 to get reasonable performance.
build:asan-common --copt -O1
build:asan-common --copt -fno-optimize-sibling-calls

# Base TSAN config
build:tsan --action_env=ENVOY_TSAN=1
build:tsan --config=sanitizer
build:tsan --define ENVOY_CONFIG_TSAN=1
build:tsan --copt -fsanitize=thread
build:tsan --linkopt -fsanitize=thread
build:tsan --linkopt=-Wl,--allow-multiple-definition
build:tsan --copt -DTHREAD_SANITIZER=1
build:tsan --build_tag_filters=-no_san,-no_tsan
build:tsan --test_tag_filters=-no_san,-no_tsan
# Needed due to https://github.com/libevent/libevent/issues/777
build:tsan --copt -DEVENT__DISABLE_DEBUG_MODE
# https://github.com/abseil/abseil-cpp/issues/760
# https://github.com/google/sanitizers/issues/953
build:tsan --test_env="TSAN_OPTIONS=report_atomic_races=0"
build:tsan --test_timeout=120,600,1500,4800

# Compile database generation config
build:compdb --build_tag_filters=-nocompdb

#############################################################################
# SORTIE: BuildBuddy remote execution. The engine is an Envoy build; without
# remote execution a cold build takes hours and more disk than a CI runner has.
# Auth is a secret, passed on the command line (CI) or from user.bazelrc:
#   build:rbe-buildbuddy --remote_header=x-buildbuddy-api-key=...
#############################################################################

build:rbe-buildbuddy --remote_executor=grpcs://remote.buildbuddy.io
build:rbe-buildbuddy --remote_cache=grpcs://remote.buildbuddy.io
build:rbe-buildbuddy --bes_backend=grpcs://remote.buildbuddy.io
build:rbe-buildbuddy --bes_results_url=https://app.buildbuddy.io/invocation/
build:rbe-buildbuddy --nolegacy_important_outputs
build:rbe-buildbuddy --remote_cache_compression
build:rbe-buildbuddy --remote_timeout=3600s
build:rbe-buildbuddy --grpc_keepalive_time=30s
build:rbe-buildbuddy --remote_retries=10
build:rbe-buildbuddy --experimental_remote_cache_eviction_retries=5
build:rbe-buildbuddy --jobs=200
# Keep build outputs remote: a full engine build is hundreds of GB of objects.
build:rbe-buildbuddy --remote_download_toplevel
# Fail rather than silently building Envoy on the driver when the remote is
# misconfigured.
build:rbe-buildbuddy --noremote_local_fallback
# rules_img downloads image layers in a build action; executors have no network.
build:rbe-buildbuddy --strategy=DownloadBlob=local

build:rbe-buildbuddy-amd64 --config=rbe-buildbuddy
build:rbe-buildbuddy-amd64 --host_platform=//bazel/platforms:rbe_buildbuddy_amd64
build:rbe-buildbuddy-amd64 --extra_execution_platforms=//bazel/platforms:rbe_buildbuddy_amd64

# Needs an arm64 driver host: the hermetic toolchains derive their exec
# constraints from the host that runs Bazel.
build:rbe-buildbuddy-arm64 --config=rbe-buildbuddy
build:rbe-buildbuddy-arm64 --host_platform=//bazel/platforms:rbe_buildbuddy_arm64
build:rbe-buildbuddy-arm64 --extra_execution_platforms=//bazel/platforms:rbe_buildbuddy_arm64

#############################################################################
# SORTIE: release build of the engine
#############################################################################

# Optimised, with DWARF stripped. --strip=always maps to the linker's
# --strip-debug: the symbol table stays, which profilers need to symbolise
# native frames.
build:engine-release -c opt
build:engine-release --strip=always

# Local developer overrides (remote cache, RBE, ...) live here and are gitignored.
try-import %workspace%/user.bazelrc
