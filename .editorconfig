# For editors. gofmt owns Go formatting and buildifier owns Bazel's; this only
# covers the files neither of them touches.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.go]
indent_style = tab

[*.{bzl,bazel}]
indent_style = space
indent_size = 4

[*.{yaml,yml}]
indent_style = space
indent_size = 2

[*.sh]
indent_style = space
indent_size = 2

[*.proto]
indent_style = space
indent_size = 2
