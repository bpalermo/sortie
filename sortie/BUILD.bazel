load("@rules_go//go:def.bzl", "go_binary", "go_library")
load("//bazel/image:defs.bzl", "go_image")

go_library(
    name = "sortie_lib",
    srcs = ["main.go"],
    importpath = "github.com/bpalermo/sortie/sortie",
    visibility = ["//visibility:private"],
    deps = ["//internal/cli"],
)

go_binary(
    name = "sortie",
    embed = [":sortie_lib"],
    visibility = ["//visibility:public"],
    # Without this the binary reports "dev" and cannot say what it is, which is
    # the first question asked of a load generator that produced a surprising
    # number. STABLE_GIT_VERSION is `git describe --tags --always --dirty`, the
    # same value the chart stamps into appVersion, so a running pod and the
    # release it came from agree. `build --stamp` is set in .bazelrc.
    x_defs = {"github.com/bpalermo/sortie/sortie.version": "{STABLE_GIT_VERSION}"},
)

# The image lives beside the binary it contains rather than in a package of its
# own: the two are edited together, and a separate //image package meant the
# layer's only content was a label pointing back here.
go_image(
    name = "image",
    binary = ":sortie",
    labels = {
        "org.opencontainers.image.description": "Declarative load-test plans on Nighthawk",
        "org.opencontainers.image.licenses": "Apache-2.0",
        "org.opencontainers.image.source": "https://github.com/bpalermo/sortie",
    },
    registry = "ghcr.io",
    repository = "bpalermo/sortie",
)

# Read as data by //bazel/stamp:stamp_test, which checks that the version
# stamping wiring in this file has not been removed.
exports_files([
    "BUILD.bazel",
    "main.go",
])
