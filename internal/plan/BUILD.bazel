load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "plan",
    srcs = [
        "defaults.go",
        "dns.go",
        "plan.go",
        "validate.go",
    ],
    importpath = "github.com/bpalermo/sortie/internal/plan",
    visibility = ["//:__subpackages__"],
    deps = [
        "//api/sortie/plan/v1:plan",
        "//engine/api/client:base_go_proto",
        "//internal/threshold",
        "@build_buf_go_protovalidate//:protovalidate",
        "@build_buf_go_protoyaml//:protoyaml",
        "@org_golang_google_protobuf//proto",
    ],
)

go_test(
    name = "plan_test",
    size = "small",
    srcs = [
        "dns_test.go",
        "plan_test.go",
    ],
    embed = [":plan"],
    deps = [
        "@envoy_api//envoy/config/metrics/v3:pkg_go_proto",
        "@org_golang_google_protobuf//types/known/anypb",
    ],
)
