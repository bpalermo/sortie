load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "result",
    srcs = ["result.go"],
    importpath = "github.com/bpalermo/sortie/internal/result",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/metric",
        "//internal/threshold",
        "@nighthawk_api//:client_go_proto",
        "@org_golang_google_protobuf//types/known/durationpb",
    ],
)

go_test(
    name = "result_test",
    size = "small",
    srcs = ["result_test.go"],
    embed = [":result"],
    deps = [
        "//internal/threshold",
        "@nighthawk_api//:client_go_proto",
        "@org_golang_google_protobuf//types/known/durationpb",
    ],
)
