load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "report",
    srcs = ["report.go"],
    importpath = "github.com/bpalermo/sortie/internal/report",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/compile",
        "//internal/run",
