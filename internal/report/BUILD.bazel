go_test(
    name = "report_test",
    size = "small",
    srcs = ["report_test.go"],
    deps = [
        ":report",
        "//engine/api/client:base_go_proto",
        "//internal/result",
        "//internal/run",
        "//internal/threshold",
        "@org_golang_google_protobuf//types/known/durationpb",
    ],
)
