# The Nighthawk proto fetch and its BUILD template live in //bazel/nighthawk.
# This package exists so the Starlark directly under bazel/ is still linted.

filegroup(
    name = "starlark_srcs",
    srcs = glob(
        [
            "*.bzl",
            "*.bazel",
            "*.BUILD",
        ],
        allow_empty = True,
    ),
    visibility = ["//:__pkg__"],
)

# Read as data by //tools/stamp:stamp_test, which checks that this still emits
# the key the version stamping depends on.
exports_files(["workspace_status.sh"])
