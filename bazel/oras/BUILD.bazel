load("@rules_shell//shell:sh_binary.bzl", "sh_binary")
load("@rules_shell//shell:sh_test.bzl", "sh_test")

# The oras CLI, pinned per platform in MODULE.bazel (official release archives,
# sha256 from the release's checksums file). chart_push (//bazel/helm:defs.bzl)
# pushes the chart with it, because `helm push` cannot name the flat
# `chart-<name>` repository Quay needs (//bazel:registry.bzl).

config_setting(
    name = "linux_amd64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "linux_arm64",
    constraint_values = [
        "@platforms//os:linux",
        "@platforms//cpu:aarch64",
    ],
)

config_setting(
    name = "darwin_amd64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:x86_64",
    ],
)

config_setting(
    name = "darwin_arm64",
    constraint_values = [
        "@platforms//os:macos",
        "@platforms//cpu:aarch64",
    ],
)

alias(
    name = "oras_bin",
    actual = select(
        {
            ":darwin_amd64": "@oras_cli_darwin_amd64//:oras",
            ":darwin_arm64": "@oras_cli_darwin_arm64//:oras",
            ":linux_amd64": "@oras_cli_linux_amd64//:oras",
            ":linux_arm64": "@oras_cli_linux_arm64//:oras",
        },
        no_match_error = "//bazel/oras: no pinned oras release for this platform (linux/darwin x amd64/arm64 only; see MODULE.bazel)",
    ),
    visibility = ["//visibility:public"],
)

# `bazel run //bazel/oras -- <args>`: the pinned oras, for a workstation.
sh_binary(
    name = "oras",
    srcs = ["oras.sh"],
    data = [":oras_bin"],
    env = {"ORAS_RLOCATIONPATH": "$(rlocationpath :oras_bin)"},
    visibility = ["//visibility:public"],
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

# Fails until EXPECTED in version_test.sh moves with a bump of the archives.
sh_test(
    name = "version_test",
    size = "small",
    srcs = ["version_test.sh"],
    data = [":oras_bin"],
    env = {"ORAS_RLOCATIONPATH": "$(rlocationpath :oras_bin)"},
    deps = ["@bazel_tools//tools/bash/runfiles"],
)

filegroup(
    name = "starlark_srcs",
    srcs = glob(
        [
            "*.bzl",
            "*.bazel",
        ],
        allow_empty = True,
    ),
    visibility = ["//:__pkg__"],
)
