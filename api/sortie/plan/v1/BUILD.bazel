load("@com_google_protobuf//bazel:proto_library.bzl", "proto_library")
load("@rules_go//go:def.bzl", "go_library")
load("@rules_go//proto:def.bzl", "go_proto_library")

proto_library(
    name = "planv1_proto",
    srcs = ["plan.proto"],
    visibility = ["//visibility:public"],
    deps = [
        "@com_google_protobuf//:duration_proto",
        "@nighthawk_api//:client_proto",
        "@protovalidate//proto/protovalidate/buf/validate:validate_proto",
    ],
)

go_proto_library(
    name = "planv1_go_proto",
    importpath = "github.com/bpalermo/sortie/api/sortie/plan/v1",
    proto = ":planv1_proto",
    visibility = ["//visibility:public"],
    deps = [
        "@build_buf_gen_go_bufbuild_protovalidate_protocolbuffers_go//buf/validate",
        "@nighthawk_api//:client_go_proto",
    ],
)

go_library(
    name = "plan",
    embed = [":planv1_go_proto"],
    importpath = "github.com/bpalermo/sortie/api/sortie/plan/v1",
    visibility = ["//visibility:public"],
)
