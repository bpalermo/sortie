load("@gazelle//:def.bzl", "gazelle")
load("@rules_go//go:def.bzl", "TOOLS_NOGO", "go_binary", "go_library", "nogo")
load("//bazel/image:defs.bzl", "go_image")
load("//bazel/lint:linters.bzl", "buildifier_test")

# gazelle:prefix github.com/bpalermo/sortie

# Nighthawk's protos are generated by Bazel from a pinned archive, so these
# import paths have no Go module behind them and only Bazel can resolve them.
# gazelle:resolve go github.com/envoyproxy/nighthawk/api/client @nighthawk_api//:client_go_proto
# gazelle:resolve go github.com/envoyproxy/nighthawk/api/distributor @nighthawk_api//:distributor_go_proto
# gazelle:resolve go github.com/envoyproxy/nighthawk/api/rate_limiter @nighthawk_api//:rate_limiter_go_proto

# Envoy's types must come from envoy_api rather than the go-control-plane Go
# module, because that is where the Nighthawk proto targets above get theirs.
# Two targets carrying the same Go importpath would put a second copy of every
# envoy message in the binary and panic at init on duplicate registration.
# gazelle:resolve go github.com/envoyproxy/go-control-plane/envoy/config/core/v3 @envoy_api//envoy/config/core/v3:pkg_go_proto

# The plan schema imports Nighthawk's and protovalidate's protos. Both live in
# external repositories, but their import paths ("api/client/...", "buf/...")
# look like directories in this repo, so gazelle resolves them to local
# packages that do not exist unless told otherwise.
# gazelle:resolve proto api/client/options.proto @nighthawk_api//:client_proto
# gazelle:resolve proto go api/client/options.proto @nighthawk_api//:client_go_proto
# gazelle:resolve proto buf/validate/validate.proto @protovalidate//proto/protovalidate/buf/validate:validate_proto
# gazelle:resolve proto go buf/validate/validate.proto @build_buf_gen_go_bufbuild_protovalidate_protocolbuffers_go//buf/validate

gazelle(name = "gazelle")

go_library(
    name = "sortie_lib",
    srcs = ["main.go"],
    importpath = "github.com/bpalermo/sortie",
    visibility = ["//visibility:private"],
    deps = ["//internal/cli"],
)

go_binary(
    name = "sortie",
    embed = [":sortie_lib"],
    visibility = ["//visibility:public"],
    # Without this the binary reports "dev" and cannot say what it is, which is
    # the first question asked of a load generator that produced a surprising
    # number. STABLE_GIT_VERSION is `git describe --tags --always --dirty`, the
    # same value the chart stamps into appVersion, so a running pod and the
    # release it came from agree. `build --stamp` is set in .bazelrc.
    x_defs = {"github.com/bpalermo/sortie.version": "{STABLE_GIT_VERSION}"},
)

# The image is declared beside the binary it contains, which is now the root.
go_image(
    name = "image",
    binary = ":sortie",
    labels = {
        "org.opencontainers.image.description": "Declarative load-test plans on Nighthawk",
        "org.opencontainers.image.licenses": "Apache-2.0",
        "org.opencontainers.image.source": "https://github.com/bpalermo/sortie",
    },
    registry = "ghcr.io",
    repository = "bpalermo/sortie",
)

# nogo is declared at the root because MODULE.bazel's go_sdk.nogo() needs a
# label that does not move: it is build configuration for every Go target in
# the repository, not a component of any package.
nogo(
    name = "nogo",
    config = "nogo.json",
    visibility = ["//visibility:public"],
    deps = TOOLS_NOGO,
)

# MODULE.bazel and go.mod default to //visibility:private as source file
# targets; //bazel/deps:deps_test needs both by label to check the x/tools
# floor against the pinned Go SDK version. .bazelrc is the same, for
# //bazel/stamp:stamp_test, which checks that --stamp is still set.
exports_files([
    ".bazelrc",
    "BUILD.bazel",
    "MODULE.bazel",
    "go.mod",
    "main.go",
])

# Hand-written Starlark. Gazelle-generated BUILD files are excluded: they are
# already canonically formatted, and CI fails separately if regenerating them
# produces a diff.
filegroup(
    name = "starlark",
    srcs = [
        "BUILD.bazel",
        "MODULE.bazel",
        "//bazel:starlark_srcs",
        "//bazel/image:starlark_srcs",
        "//bazel/lint:starlark_srcs",
        "//bazel/nighthawk:starlark_srcs",
        "//charts/sortie:starlark_srcs",
    ],
    tags = ["starlark"],
    # //bazel/deps reads these to check that every bazel-only requirement is
    # still named by a hand-written Bazel file.
    visibility = ["//bazel/deps:__pkg__"],
)

buildifier_test(
    name = "buildifier_test",
    size = "small",
    srcs = [":starlark"],
    tags = ["lint"],
)
