load("@rules_helm//helm:defs.bzl", "helm_chart", "helm_lint_test", "helm_template_test")

# images pins the digest of //image:image_push into the chart at package time,
# so the chart and the image it names cannot drift, and `bazel run :sortie.push`
# publishes both together.
helm_chart(
    name = "sortie",
    chart = "Chart.yaml",
    images = ["//image:image_push"],
    login_url = "ghcr.io",
    registry_url = "oci://ghcr.io/bpalermo/sortie/charts",
    templates = glob(["templates/**"]),
    values = "values.yaml",
    visibility = ["//visibility:public"],
)

helm_lint_test(
    name = "sortie_lint_test",
    size = "small",
    chart = ":sortie",
)

helm_template_test(
    name = "sortie_template_test",
    size = "small",
    chart = ":sortie",
)

filegroup(
    name = "starlark_srcs",
    srcs = glob(
        [
            "*.bzl",
            "*.bazel",
            "*.BUILD",
        ],
        allow_empty = True,
    ),
    visibility = ["//:__pkg__"],
)
